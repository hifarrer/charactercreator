# WaveSpeed.ai API key (required for image generation)
WAVESPEED_API_KEY=your_wavespeed_api_key_here

# FFmpeg API (ffmpegapi.net) — video to GIF conversion (X-API-Key)
FFMPEG_API_KEY=your_ffmpegapi_key_here

# OpenAI API key (required for multi-pose prompt generation)
OPENAI_API_KEY=your_openai_api_key_here
# Optional override (default gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Static API token for authenticating frontend requests (required)
API_TOKEN=your_secret_token_here

# Expose token to frontend for auto-login (set same value as API_TOKEN)
NEXT_PUBLIC_API_TOKEN=your_secret_token_here
